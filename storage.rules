rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 관리자 판별은 Firestore `admins/{이메일(소문자)}` 문서로 한다 (교차 서비스 규칙).
    // 교차 서비스 규칙에는 Storage 서비스 계정의 roles/firebaserules.firestoreServiceAgent 권한이 필요하다.
    // (대화형 `firebase deploy --only storage` 시 CLI가 부여를 묻는다. --non-interactive에서는 건너뜀)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email.lower()));
    }

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // 광고 이미지, 사이트 콘텐츠 이미지: 누구나 보기, 관리자만 올리기/지우기
    match /ads/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder5MB();
      allow delete: if isAdmin();
    }

    match /content/{pageId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder5MB();
      allow delete: if isAdmin();
    }

    // 그 외 경로는 모두 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
